# ===================================================
# InvenTrack Environment Configuration Template
# Copy this file to .env before starting the app:
# cp .env.example .env
# ===================================================

# Server Port
PORT=5000

# Database Connection (Zero-Config SQLite vs Cloud PostgreSQL):
# -----------------------------------------------------------
# OPTION A (Recommended for Local Dev):
# Leave DATABASE_URL empty or commented out. The app automatically 
# uses embedded SQLite (backend/inventrack.db) with auto-migration and seeding.
# DATABASE_URL=

# OPTION B (For Cloud Deployment / Managed PostgreSQL on Render.com):
# DATABASE_URL=postgres://username:password@hostname:5432/database_name?ssl=true

# Security Key for JWT Authentication Signatures
JWT_SECRET=inventrack_super_secret_jwt_key_2026_cscd602

# Node Execution Environment (development | production)
NODE_ENV=development

# Frontend API Base URL
VITE_API_URL=http://localhost:5000/api
